# Токен бота от @BotFather
BOT_TOKEN=

# Необязательно. Токен доступа к API hh.ru (OAuth), нужен только для получения
# контактов работодателя, которые hh.ru скрывает от анонимных посетителей.
HH_TOKEN=

# Необязательно. Ваш Telegram user id. Если указан — бот работает только для вас.
OWNER_ID=

# Необязательно. Прокси для доступа к Telegram API, если он заблокирован:
# http://127.0.0.1:10809 или socks5://127.0.0.1:10808
PROXY_URL=

# Необязательно. Размер пачки вакансий до остановки.
BATCH_SIZE=10

# Необязательно. Пауза между сообщениями с вакансиями (секунды).
MESSAGE_DELAY=1.4

# Необязательно. Пауза между страницами поиска hh.ru (секунды).
PAGE_DELAY=1.0

# Необязательно. Максимум страниц hh.ru за один запуск (1 страница = до 50 вакансий).
MAX_PAGES=40
